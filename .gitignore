# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.env

# Jupyter Notebooks
.ipynb_checkpoints

# Data (Exclude large files, keep structure)
data/raw/*
data/raw_vww/*
data/raw_coco_*/
data/processed/*
data/augmented/*
data/hil_frames*/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/augmented/.gitkeep
!data/raw_vww/vww_subset_report.json

# Splits. data/splits/ is the working partition of the user's own dataset and
# is ignored entirely. The published partitions live in named folders
# (data/splits_coco, data/splits_plates, data/splits_vww): their copied images
# are ignored, their manifests and reports are versioned so the partition stays
# reproducible.
data/splits/
data/splits_*/*/

# Models (Exclude heavy weights)
models/checkpoints/*
!models/checkpoints/.gitkeep
*.h5
*.keras
*.tflite
# Label order written next to each .tflite by quantize_int8_basic.py
models/tflite/*.classes.txt

# Scratch smoke-test outputs
results/smoke_test/
# Preview that calibrate_hil_rig.py --live rewrites at every capture
live_latest.png

# Arduino / PlatformIO
.pio/
.pioenvs/
.piolibdeps/
*.elf
*.hex
*.bin
*.map

# OS
.DS_Store
Thumbs.db